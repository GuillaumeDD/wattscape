{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Lets tools/*.ts import src/*.ts under `node --experimental-strip-types`, which
    // needs the .ts extension. Remove if the tools move to a bundler-run script.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "tools",
    "e2e",
    "vite.config.ts",
    "vite.e2e.config.ts",
    "playwright.config.ts"
  ]
}
